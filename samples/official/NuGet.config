<?xml version="1.0" encoding="utf-8"?>
<!-- Official samples consume unsigned packages built locally by eng\build-official-decision-packages.ps1. -->
<configuration>
  <packageSources>
    <clear />
    <add key="official-decisions" value="../../artifacts/official-feed" />
    <add key="nuget.org" value="https://www.nuget.org/api/v2/" protocolVersion="2" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="official-decisions">
      <package pattern="Microsoft.Extensions.AI" />
      <package pattern="Microsoft.Extensions.AI.Abstractions" />
      <package pattern="Microsoft.Extensions.AI.OpenAI" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
