<Project Sdk="Microsoft.NET.Sdk">
  <!-- An IDecisionClient for Ollama's /v1/systemone endpoint, built against packages from the local official feed. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <NoWarn>$(NoWarn);MEAI001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.0-decisions.1" />
  </ItemGroup>
</Project>
